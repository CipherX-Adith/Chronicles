generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String   @default("Admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Submission {
  id              String         @id @default(cuid())
  publicId        String         @unique // e.g. MC-7F42 or MC-0042
  fromName        String?
  fromClass       String?
  fromDepartment  String?
  toName          String?
  toClass         String?
  toDepartment    String?
  message         String
  status          String         @default("PENDING") // PENDING, GENERATED, PUBLISHED, REJECTED
  rejectionReason String?
  rejectedAt      DateTime?
  rejectedBy      String?
  postedAt        DateTime?
  postedBy        String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  instagramPost   InstagramPost?
}

model InstagramPost {
  id           String     @id @default(cuid())
  submissionId String     @unique
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  template     String     @default("editorial-classic")
  status       String     @default("GENERATED") // GENERATED, POSTED
  instagramId  String?
  createdAt    DateTime   @default(now())
  publishedAt  DateTime?
}
